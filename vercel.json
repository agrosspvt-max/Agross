{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/enquiry.js": {
      "maxDuration": 20
    },
    "api/admin.js": {
      "maxDuration": 20
    },
    "api/admin-page.js": {
      "includeFiles": "admin/views/**"
    },
    "api/listing.js": {
      "includeFiles": "{chemicals,nonchemical}.html"
    },
    "api/catalogue.js": {
      "maxDuration": 10
    },
    "api/image.js": {
      "maxDuration": 10
    },
    "api/recruitment-bin-cleanup.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/recruitment-bin-cleanup",
      "schedule": "30 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/chemicals.html",
      "destination": "/api/listing?page=chemicals"
    },
    {
      "source": "/nonchemical.html",
      "destination": "/api/listing?page=nonchemical"
    },
    {
      "source": "/api/admin/:route",
      "destination": "/api/admin?route=:route"
    },
    {
      "source": "/admin",
      "destination": "/api/admin-page?p="
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin-page?p=:path*"
    }
  ]
}
