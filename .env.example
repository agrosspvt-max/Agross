# Copy to .env.local for local development. Names only; real values live in the hosting settings.
DATABASE_URL=postgres://agross@127.0.0.1:5433/agross
TEST_DATABASE_URL=postgres://agross@127.0.0.1:5433/agross_test

# Production and preview (set in Vercel, never in a file):
# DATABASE_URL        PostgreSQL connection string (Neon pooled endpoint)
# BREVO_API_KEY       Brevo API key
# FORM_FROM_EMAIL     verified Brevo sender
# BREVO_WEBHOOK_SECRET shared secret Brevo sends with delivery events
# IP_HASH_SALT        long random string used to hash IP addresses for rate limiting
